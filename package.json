{
  "name": "pietro",
  "version": "0.6.1",
  "type": "module",
  "description": "Convert PDF files to PNG and text files",
  "author": "Pixelastic <tim@pixelastic.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/git@github.com:pixelastic/pietro.git"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.18.0",
  "files": [
    "./lib/*.js",
    "./Dockerfile",
    "./CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/main.js"
  },
  "main": "./lib/main.js",
  "devDependencies": {
    "aberlaas": "2.42.0"
  },
  "dependencies": {
    "firost": "5.11.2",
    "golgoth": "4.1.1"
  },
  "scripts": {
    "ci": "./scripts/ci",
    "compress": "./scripts/compress",
    "docker:dev": "./scripts/docker-dev",
    "docker:run": "./scripts/docker-run",
    "fixtures:generate": "node ./scripts/fixtures-generate.js",
    "husky:precommit": "./scripts/husky-precommit",
    "lint": "./scripts/lint",
    "lint:fix": "./scripts/lint-fix",
    "release": "./scripts/release",
    "simulate-circleci": "./scripts/simulate-circleci",
    "test": "./scripts/test",
    "test:watch": "./scripts/test-watch"
  },
  "aberlaas": {
    "trustedPublisher": true
  }
}
